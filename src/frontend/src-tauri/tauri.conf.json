{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ETS2 Mod Manager",
  "version": "0.1.0",
  "identifier": "com.ets2modmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "initializer",
        "title": "ETS2 Mod Manager",
        "width": 440,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "center": true
      },
      {
        "label": "main",
        "title": "ETS2 Mod Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
