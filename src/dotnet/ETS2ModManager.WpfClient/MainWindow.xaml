<Window x:Class="ETS2ModManager.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Ui.AppTitle}"
        Width="1280" Height="820"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel Background="{StaticResource WindowBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource InsetBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <ToolBar Background="Transparent" BorderThickness="0" Padding="8,6" Height="48">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartScanCommand}" Content="{Binding Ui.ScanMods}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding CancelScanCommand}" Content="{Binding Ui.CancelScan}" />
                <Separator />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding EnableAllModsCommand}" Content="{Binding Ui.EnableAll}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding DisableAllModsCommand}" Content="{Binding Ui.DisableAll}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleAllModsCommand}" Content="{Binding Ui.Invert}" />
                <Separator />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveModTopCommand}" Content="{Binding Ui.Top}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveModUpCommand}" Content="{Binding Ui.Up}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveModDownCommand}" Content="{Binding Ui.Down}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveModBottomCommand}" Content="{Binding Ui.Bottom}" />
                <Separator />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveProfileCommand}" Content="{Binding Ui.SaveProfile}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding LaunchGameCommand}" Content="{Binding Ui.LaunchGame}" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding AnalyzeCrashCommand}" Content="{Binding Ui.CrashCheck}" />
                <ComboBox ItemsSource="{Binding Ui.Languages}" SelectedValue="{Binding Ui.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" Width="110" Margin="12,0,0,0" ToolTip="{Binding Ui.LanguageLabel}" />
            </ToolBar>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource InsetBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,7">
            <Grid>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Ui.CoreFooter}" Foreground="{StaticResource TextMuteBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Ui.Profiles}" Style="{StaticResource SectionLabel}" />
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                 DisplayMemberPath="DisplayName" Height="190" />
                        <Button Command="{Binding RefreshProfilesCommand}" Content="{Binding Ui.RefreshProfiles}" Margin="0,9,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Text="{Binding ProfileDisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Ui.ProfileNameHint}" />
                            <TextBox Grid.Row="1" Text="{Binding ProfileCompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" ToolTip="{Binding Ui.CompanyNameHint}" />
                        </Grid>
                        <UniformGrid Rows="1" Columns="3" Margin="0,8,0,0">
                            <Button Command="{Binding RenameProfileCommand}" Content="{Binding Ui.Rename}" Margin="0,0,4,0" />
                            <Button Command="{Binding CopyProfileCommand}" Content="{Binding Ui.Copy}" Margin="2,0,2,0" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteProfileCommand}" Content="{Binding Ui.Delete}" Margin="4,0,0,0" />
                        </UniformGrid>
                    </StackPanel>

                    <GroupBox Header="{Binding Ui.Categories}" DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding CategoryStatus}" Foreground="{StaticResource TextMuteBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="190">
                                <ItemsControl ItemsSource="{Binding CategoryFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextDimBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <TabControl>
                    <TabItem Header="{Binding Ui.Mods}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="170" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Ui.ModInventory}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Button Grid.Column="1" Command="{Binding EnableAllModsCommand}" Content="{Binding Ui.EnableAll}" Margin="0,0,6,0" />
                                <Button Grid.Column="2" Command="{Binding DisableAllModsCommand}" Content="{Binding Ui.DisableAll}" />
                                <TextBox Grid.Column="4" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="{Binding Ui.PresetName}" />
                                <Button Grid.Column="5" Command="{Binding SavePresetCommand}" Content="{Binding Ui.SavePreset}" Margin="6,0,0,0" />
                                <ComboBox Grid.Column="6" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName}" Width="150" Margin="6,0,0,0" />
                                <Button Grid.Column="7" Command="{Binding LoadPresetCommand}" Content="{Binding Ui.LoadPreset}" Margin="6,0,0,0" />
                                <Button Grid.Column="8" Style="{StaticResource DangerButton}" Command="{Binding DeletePresetCommand}" Content="{Binding Ui.DeletePreset}" Margin="6,0,0,0" />
                            </Grid>
                            <DataGrid x:Name="ModGrid" Grid.Row="1" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                                      SelectionMode="Single" AllowDrop="True" AutoGenerateColumns="False" IsReadOnly="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      PreviewMouseLeftButtonDown="ModGrid_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="ModGrid_PreviewMouseMove" Drop="ModGrid_Drop" DragOver="ModGrid_DragOver">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="76" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding PackageType}" Width="110" />
                                    <DataGridTextColumn Header="Package" Binding="{Binding PackageName}" Width="210" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Background="{StaticResource InsetBrush}" Padding="10" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#E5EAF1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Ui.ModPreview}" Foreground="{StaticResource TextMuteBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedModName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding SelectedModPackage}" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,8" />
                                        <TextBlock Text="{Binding SelectedModType}" Foreground="{StaticResource TextMuteBrush}" />
                                        <TextBlock Text="{Binding SelectedModPath}" Foreground="{StaticResource TextMuteBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding Ui.Saves}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding RefreshSaveSlotsCommand}" Content="{Binding Ui.Refresh}" />
                                <ComboBox ItemsSource="{Binding SaveSlots}" SelectedItem="{Binding SelectedSaveSlot}" DisplayMemberPath="DisplayName" Width="240" Margin="8,0" />
                                <Button Command="{Binding CopySaveSlotCommand}" Content="{Binding Ui.CopySlot}" />
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                                <TextBlock Text="{Binding Ui.Money}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,5,0"/><TextBox Text="{Binding SaveAmount}" Width="105" Margin="0,0,8,0"/>
                                <Button Command="{Binding SetMoneyCommand}" Content="{Binding Ui.Set}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Ui.Xp}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,5,0"/><TextBox Text="{Binding SaveExperience}" Width="105" Margin="0,0,8,0"/>
                                <Button Command="{Binding SetExperienceCommand}" Content="{Binding Ui.Set}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Ui.Level}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,5,0"/><TextBox Text="{Binding SaveLevel}" Width="55" Margin="0,0,8,0"/>
                                <Button Command="{Binding SetLevelCommand}" Content="{Binding Ui.Set}" Margin="0,0,14,0"/>
                                <Button Command="{Binding RepairTruckCommand}" Content="{Binding Ui.Repair}" Margin="0,0,6,0"/>
                                <Button Command="{Binding RefuelTruckCommand}" Content="{Binding Ui.Refuel}" Margin="0,0,6,0"/>
                                <Button Command="{Binding UnlockAllGaragesCommand}" Content="{Binding Ui.UnlockGarages}" />
                                <Button Command="{Binding UnlockAllDealersCommand}" Content="{Binding Ui.UnlockDealers}" Margin="6,0,0,0" />
                            </WrapPanel>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding SaveFields}" AutoGenerateColumns="True" IsReadOnly="True" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding Ui.Localization}">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanLocalizationCommand}" Content="{Binding Ui.ScanLocalization}" />
                                <Button Command="{Binding CancelLocalizationCommand}" Content="{Binding Ui.Cancel}" Margin="7,0,0,0" />
                                <Button Command="{Binding ImportLocalizationDictionaryCommand}" Content="{Binding Ui.ImportDictionary}" Margin="7,0,0,0" />
                                <Button Command="{Binding ExportLocalizationCommand}" Content="{Binding Ui.ExportScs}" Margin="7,0,0,0" />
                                <TextBox Text="{Binding LocalizationLocale, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="7,0,0,0" ToolTip="{Binding Ui.TargetLocaleHint}" />
                                <Button Command="{Binding SelectLocalizationBaselineCommand}" Content="{Binding Ui.SelectBaseline}" Margin="7,0,0,0" />
                                <Button Command="{Binding ClearLocalizationBaselineCommand}" Content="{Binding Ui.ClearBaseline}" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding LocalizationBaseline}" Foreground="{StaticResource TextMuteBrush}" Margin="0,8,0,0" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding LocalizationStatus}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <DataGrid x:Name="LocalizationGrid" ItemsSource="{Binding LocalizationEntries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="220" />
                                    <DataGridTextColumn Header="Translation" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="120" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="100" />
                                    <DataGridTextColumn Header="Package" Binding="{Binding PackageName}" IsReadOnly="True" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="{Binding Ui.Diagnostics}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCrashCommand}" Content="{Binding Ui.AnalyzeLatestCrash}"/><Button Command="{Binding PrecheckProfileCommand}" Content="{Binding Ui.PrecheckProfile}" Margin="8,0,0,0"/></StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding CrashStatus}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,8" />
                            <DataGrid Grid.Row="2" ItemsSource="{Binding CrashSuspects}" AutoGenerateColumns="True" IsReadOnly="True" />
                            <DataGrid Grid.Row="3" ItemsSource="{Binding PrecheckIssues}" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,10,0,0" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding Ui.Cities}">
                        <DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Text="{Binding CityKeyword}" Width="240"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding SearchCitiesCommand}" Content="{Binding Ui.SearchCities}" Margin="8,0,0,0"/></StackPanel><TextBlock DockPanel.Dock="Top" Text="{Binding CityStatus}" Foreground="{StaticResource TextDimBrush}" Margin="0,8"/><DataGrid ItemsSource="{Binding CityResults}" AutoGenerateColumns="True" IsReadOnly="True" /></DockPanel>
                    </TabItem>

                    <TabItem Header="{Binding Ui.Workshop}">
                        <DockPanel Margin="12"><Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshWorkshopMetadataCommand}" Content="{Binding Ui.RefreshWorkshop}" HorizontalAlignment="Left"/><TextBlock DockPanel.Dock="Top" Text="{Binding WorkshopStatus}" Foreground="{StaticResource TextDimBrush}" Margin="0,8"/><DataGrid ItemsSource="{Binding WorkshopMetadata}" AutoGenerateColumns="True" IsReadOnly="True" /></DockPanel>
                    </TabItem>

                    <TabItem Header="{Binding Ui.CategoryManagement}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Width="240" ToolTip="{Binding Ui.CategoryNameHint}" />
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateCategoryCommand}" Content="{Binding Ui.CreateCategory}" Margin="8,0,0,0" />
                                <Button Command="{Binding AssignAllUncategorizedCommand}" Content="{Binding Ui.AssignUncategorized}" Margin="8,0,0,0" />
                                <Button Command="{Binding RefreshCategoriesCommand}" Content="{Binding Ui.RefreshCategories}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding CategoryStatus}" Foreground="{StaticResource TextDimBrush}" Margin="0,9" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding CategoryFolders}" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding Ui.Tools}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" MaxWidth="760">
                            <TextBlock Text="{Binding Ui.ModDirectoryMigration}" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding MigrationTarget}" ToolTip="{Binding Ui.TargetDirectoryHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource PrimaryButton}" Command="{Binding MigrateModsCommand}" Content="{Binding Ui.MigrateAndLink}"/><Button Command="{Binding RestoreModsCommand}" Content="{Binding Ui.Restore}" Margin="8,0,0,0"/></StackPanel>
                            <TextBlock Text="{Binding Ui.Updates}" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                            <TextBox Text="{Binding UpdateRepository}" ToolTip="{Binding Ui.RepositoryHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Command="{Binding CheckUpdateCommand}" Content="{Binding Ui.CheckUpdates}"/><Button Command="{Binding InstallUpdateCommand}" Content="{Binding Ui.InstallUpdate}" Margin="8,0,0,0"/></StackPanel>
                            <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Ui.ExternalExtractor}" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                            <TextBlock Text="{Binding ExtractorStatus}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding ExtractorPackagePath}" Margin="0,7,0,0" ToolTip="{Binding Ui.PackagePathHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBox Text="{Binding ExtractorEntryName}" Width="240" ToolTip="{Binding Ui.EntryNameHint}"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding ExtractEntryCommand}" Content="{Binding Ui.ExtractEntry}" Margin="8,0,0,0"/></StackPanel>
                            <TextBox Text="{Binding ExtractorOutput}" Margin="0,8,0,0" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
